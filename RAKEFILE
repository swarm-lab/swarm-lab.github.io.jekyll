desc 'Publishing the website via rsync'
task :deploy do
  dry_run = ENV["DRY_RUN"] == "1"
  user = 'simon'
  server = 'theswarmlab.com'
  path = 'theswarmlab/static'
  options = "-rtzh --delete --delete-excluded --exclude='.git/' --exclude='.DS_Store' --exclude='._*'"
  options = "--dry-run --itemize-changes #{options}" if dry_run
  sh "rsync #{options} _site/ #{user}@#{server}:#{path}"
  puts(dry_run ? 'Dry run complete.' : 'Your website is now published!')
end
